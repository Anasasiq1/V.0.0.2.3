# ==========================================
# n8n Core Instance Configuration
# ==========================================
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/webhook/hyperlocal-order-webhook
N8N_ENCRYPTION_KEY=generate_a_random_32_char_encryption_key_here
N8N_WEBHOOK_SECRET=your_optional_signing_secret

# ==========================================
# WhatsApp Provider Configuration (in n8n)
# Options: EVOLUTION_API | META_CLOUD_API | WAHA | GENERIC
# Default is provider-agnostic GENERIC / META / EVOLUTION
# ==========================================
WHATSAPP_PROVIDER=GENERIC

# Option A: Evolution API Settings
EVOLUTION_API_BASE_URL=http://evolution_api:8080
EVOLUTION_API_KEY=your_evolution_api_key_secret
EVOLUTION_INSTANCE_NAME=hyperlocal_store

# Option B: Meta WhatsApp Cloud API Settings
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=

# Option C: WAHA / Generic HTTP Gateway Settings
GENERIC_WA_API_URL=http://waha:3000/api/sendText
