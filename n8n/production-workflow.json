{
  "name": "Hyperlocal WhatsApp Order Dispatch Workflow - Provider Agnostic",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "hyperlocal-order-webhook",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-webhook-trigger",
      "name": "Order Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [200, 300],
      "webhookId": "hyperlocal-order-webhook-id"
    },
    {
      "parameters": {
        "jsCode": "// Extract order data with fallback compatibility for both raw order or nested payload\nconst rawBody = $input.item.json.body || $input.item.json;\nconst order = rawBody.order || rawBody;\n\nconst orderId = order.order_id || order.id || `ORD-${Date.now()}`;\nconst storeName = order.store_name || rawBody.store_name || 'Hyperlocal Store';\nconst storePhone = order.merchant_whatsapp_phone || rawBody.merchant_whatsapp_phone || '919876543210';\nconst customerName = order.customer_name || 'Valued Customer';\nconst customerPhone = order.customer_whatsapp || order.customer_phone || rawBody.customer_phone || '';\nconst deliveryAddress = order.delivery_address || order.notes || 'As per customer profile';\nconst deliverySlot = order.delivery_slot || order.delivery_slot_time || 'Standard Delivery (20-30 min)';\nconst paymentMethod = (order.payment_method || 'COD').toUpperCase();\nconst totalAmount = order.total_amount || order.final_total || 0;\nconst deliveryFee = order.delivery_fee || 0;\n\n// Format items list\nconst items = Array.isArray(order.items) ? order.items : [];\nconst formattedItemsText = items.map((item, idx) => {\n  const name = item.name || `Item ${idx + 1}`;\n  const qty = item.quantity || item.qty || 1;\n  const price = item.price || 0;\n  return `• ${name} x ${qty} = ₹${price * qty}`;\n}).join('\\n');\n\n// Construct Customer Message\nconst customerMessage = `🛒 *നിങ്ങളുടെ ഓർഡർ വിജയകരമായി ലഭിച്ചിരിക്കുന്നു!*\n\n*ഓർഡർ ഐഡി:* ${orderId}\n*സ്റ്റോർ:* ${storeName}\n*ആകെ തുക:* ₹${totalAmount}\n*പേയ്‌മെന്റ് രീതി:* ${paymentMethod}\n*ഡെലിവറി സമയം:* ${deliverySlot}\n\n*ഐറ്റങ്ങൾ:*\n${formattedItemsText || '• Order Items'}\n\n*ഡെലിവറി വിലാസം:*\n${deliveryAddress}\n\nഞങ്ങളുടെ സ്റ്റോർ തിരഞ്ഞെടുത്തതിന് നന്ദി! ❤️`;\n\n// Construct Merchant Notification Message\nconst merchantMessage = `🔔 *പുതിയ ഓർഡർ എത്തിയിരിക്കുന്നു! (New Order)*\n\n*ഓർഡർ ഐഡി:* ${orderId}\n*സ്റ്റോർ:* ${storeName}\n*കസ്റ്റമർ:* ${customerName}\n*ഫോൺ:* ${customerPhone}\n*ആകെ തുക:* ₹${totalAmount}\n*പേയ്‌മെന്റ് രീതി:* ${paymentMethod}\n*ഡെലിവറി സമയം:* ${deliverySlot}\n\n*ഐറ്റങ്ങൾ:*\n${formattedItemsText || '• Order Items'}\n\n*ഡെലിവറി വിലാസം:*\n${deliveryAddress}\n\nദയവായി ഉടൻ തയ്യാറാക്കുക.`;\n\nreturn [{\n  json: {\n    order_id: orderId,\n    store_name: storeName,\n    store_phone: storePhone,\n    customer_name: customerName,\n    customer_phone: customerPhone,\n    delivery_address: deliveryAddress,\n    delivery_slot: deliverySlot,\n    payment_method: paymentMethod,\n    total_amount: totalAmount,\n    items_count: items.length,\n    customer_message: customerMessage,\n    merchant_message: merchantMessage,\n    source: rawBody.source || 'website',\n    timestamp: rawBody.timestamp || new Date().toISOString()\n  }\n}];"
      },
      "id": "node-format-payload",
      "name": "Format Messages & Extract Order",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $env.WHATSAPP_PROVIDER || 'GENERIC' }}",
              "value2": "EVOLUTION_API"
            }
          ]
        }
      },
      "id": "node-check-provider",
      "name": "Provider Router",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_API_BASE_URL || 'http://localhost:8080' }}/message/sendText/{{ $env.EVOLUTION_INSTANCE_NAME || 'default' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.EVOLUTION_API_KEY || 'YOUR_API_KEY' }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"number\": \"{{ $json.customer_phone }}\",\n  \"text\": \"{{ $json.customer_message }}\"\n}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "node-evolution-customer",
      "name": "Evolution API: Customer WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 180],
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_API_BASE_URL || 'http://localhost:8080' }}/message/sendText/{{ $env.EVOLUTION_INSTANCE_NAME || 'default' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.EVOLUTION_API_KEY || 'YOUR_API_KEY' }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"number\": \"{{ $json.store_phone }}\",\n  \"text\": \"{{ $json.merchant_message }}\"\n}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "node-evolution-merchant",
      "name": "Evolution API: Merchant WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1140, 180],
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.GENERIC_WA_API_URL || 'https://graph.facebook.com/v19.0/' + ($env.META_PHONE_NUMBER_ID || '100000000') + '/messages' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + ($env.META_ACCESS_TOKEN || 'YOUR_ACCESS_TOKEN') }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $json.customer_phone }}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"preview_url\": false,\n    \"body\": \"{{ $json.customer_message }}\"\n  }\n}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "node-meta-customer",
      "name": "Meta Cloud / WAHA / Generic Customer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 420],
      "continueOnFail": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.GENERIC_WA_API_URL || 'https://graph.facebook.com/v19.0/' + ($env.META_PHONE_NUMBER_ID || '100000000') + '/messages' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + ($env.META_ACCESS_TOKEN || 'YOUR_ACCESS_TOKEN') }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $json.store_phone }}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"preview_url\": false,\n    \"body\": \"{{ $json.merchant_message }}\"\n  }\n}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "node-meta-merchant",
      "name": "Meta Cloud / WAHA / Generic Merchant",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1140, 420],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// Aggregate results and prepare status response\nconst formatNodeData = $('Format Messages & Extract Order').first().json;\nconst orderId = formatNodeData.order_id;\n\nreturn [{\n  json: {\n    success: true,\n    order_id: orderId,\n    customer_phone: formatNodeData.customer_phone,\n    store_phone: formatNodeData.store_phone,\n    status: 'PROCESSED',\n    message: 'Order received and WhatsApp notifications processed by n8n',\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "node-status-aggregator",
      "name": "Status Aggregator",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1360, 300]
    },
    {
      "parameters": {
        "options": {
          "responseCode": 200
        },
        "responseBody": "={{ JSON.stringify($json) }}"
      },
