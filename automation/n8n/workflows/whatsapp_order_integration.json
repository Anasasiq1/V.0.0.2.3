{
  "name": "HM-Q WhatsApp Multi-Provider Order Automation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-order-webhook",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Webhook - Order Created",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [100, 200]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.item.json.body || $input.item.json;\nconst order = body.order || body;\nreturn [{ json: { ...order, source: 'hmq_platform', timestamp: new Date().toISOString() } }];"
      },
      "name": "Set - Format Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [320, 200]
    },
    {
      "parameters": {
        "options": {
          "responseCode": 200
        },
        "responseBody": "={{ JSON.stringify({ success: true, order_id: $json.order_id, status: 'RECEIVED' }) }}"
      },
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [540, 200]
    }
  ],
  "connections": {
    "Webhook - Order Created": {
      "main": [
        [
          {
            "node": "Set - Format Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set - Format Payload": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {}
}
