# ==============================================================================
# HM-Q HYPERLOCAL COMMERCE OS (V.0.0.2.3) - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER RUNTIME & PORT CONFIGURATION (NODE.JS MODE)
# ------------------------------------------------------------------------------
NODE_ENV=production
# Configurable Ports (Supported: 3000, 3001, 4302, or any server port)
PORT=4302

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (OPTIONAL MYSQL)
# ------------------------------------------------------------------------------
# By default, the app uses zero-config JSON file store (data_store.json).
# To enable MySQL, set DB_CONNECTION=mysql and provide database credentials:
DB_CONNECTION=json
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=hmqin
DB_USERNAME=root
DB_PASSWORD=your_secure_password

# ------------------------------------------------------------------------------
# 3. N8N WEBHOOK AUTOMATION (OPTIONAL)
# ------------------------------------------------------------------------------
N8N_WEBHOOK_URL=https://n8n.yourdomain.com/webhook/orders
N8N_WEBHOOK_SECRET=your_n8n_secret_token

# ------------------------------------------------------------------------------
# 4. SERVER SECRETS & AI CAPABILITIES (OPTIONAL)
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_a_secure_jwt_random_secret
GEMINI_API_KEY=
